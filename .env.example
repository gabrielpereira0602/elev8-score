# Nomes das chaves do Elev8 Score. Os valores NUNCA vão para o GitHub nem para o chat:
# preencha só no painel da Hostinger (seu app > Variáveis de ambiente).

# Endereço público do site, sem barra no fim (ex.: https://score.seudominio.com.br). Opcional: sem ele, usa o endereço da Hostinger.
SITE_URL=

# Senha do painel administrativo (/admin). Obrigatória quando o banco estiver ligado.
ADMIN_PASSWORD=

# Google Cloud: Places API (New) e PageSpeed Insights API (pode ser a mesma chave).
GOOGLE_PLACES_API_KEY=
GOOGLE_PAGESPEED_API_KEY=

# Supabase: Project Settings > API. Use a chave service_role (fica só no servidor).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Kiwify: Apps > Webhooks > Criar webhook. Copie o token que a Kiwify mostra.
KIWIFY_WEBHOOK_TOKEN=
# Opcional: link de pagamento do produto (padrão: https://pay.kiwify.com.br/yNPKVVB).
KIWIFY_CHECKOUT_URL=

# Depois (e-mails automáticos, precisa de domínio): Resend.
RESEND_API_KEY=
