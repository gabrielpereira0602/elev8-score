# Modelo das chaves do Elev8 Score.
# Os valores reais NUNCA vão para o GitHub nem para o chat: preencha direto no painel da Hostinger
# (Websites > seu app > Variáveis de ambiente). Este arquivo só lista os nomes.

# Endereço público do site (ex.: https://score.elev8.com.br)
NEXT_PUBLIC_SITE_URL=

# Fase 2: banco de dados e login (Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# E-mail que pode entrar no painel administrativo
ADMIN_EMAIL=

# Fase 2: dados reais da empresa (Google Cloud)
GOOGLE_PLACES_API_KEY=
GOOGLE_PAGESPEED_API_KEY=

# Opcional: inteligência artificial para escrever o kit sob medida (fase 3).
# O consultor funciona offline, sem esta chave e sem custo por pergunta.
ANTHROPIC_API_KEY=

# Fase 4: pagamento e e-mails
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
RESEND_API_KEY=
